{
  "compilerOptions": {
    "target": "ES2023", "module": "Preserve", "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "playwright*.config.ts"]
}
