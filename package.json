{
  "name": "opi-hub",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-web.ts",
    "init": "node src/cli.ts init",
    "hub": "node src/cli.ts hub",
    "node": "node src/cli.ts node",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:native": "playwright test --config playwright.native.config.ts",
    "build": "node scripts/prepare-web.ts && bun build src/cli.ts --target=node --outdir=dist && bun scripts/copy-assets.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "markdown-it": "^15.0.3",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
